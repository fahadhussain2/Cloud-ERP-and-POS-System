        },
        "context": {
          "bill": { "id": "019a5000-0000-7000-8000-000000000415", "cashDue": -45000 },
          "existing": null
        }
      },
      "expected": [{ "kind": "handover_not_permitted", "permission": "cash.refund.pay" }]
    },
    {
      "name": "a cashier the server doesn't know",
      "input": {
        "handover": { "cashierId": "019a0000-0000-7000-8000-0000000000a9" },
        "context": {
          "bill": { "id": "019a5000-0000-7000-8000-000000000412", "cashDue": 432000 },
          "existing": null
        }
      },
      "expected": [{ "kind": "handover_not_permitted", "permission": "cash.handover.receive" }]
