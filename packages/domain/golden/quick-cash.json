{
  "description": "Quick-cash amounts in the Cash popup (POS spec §12, D-053): for each of Rs 500, 1,000, 5,000 and 10,000 the next multiple strictly above the total; the three smallest distinct ones, topped up with multiples of Rs 5,000. Unit Rs 1 = 100.",
  "cases": [
    {
      "name": "Rs 4,320 (the prototype's example)",
      "input": { "total": 432000, "unit": 100 },
      "expected": [450000, 500000, 1000000]
    },
    {
      "name": "Rs 120",
      "input": { "total": 12000, "unit": 100 },
      "expected": [50000, 100000, 500000]
    },
    {
      "name": "Rs 500: never the total itself",
      "input": { "total": 50000, "unit": 100 },
      "expected": [100000, 500000, 1000000]
    },
    {
      "name": "Rs 9,800: every step gives Rs 10,000, topped up by Rs 5,000",
      "input": { "total": 980000, "unit": 100 },
      "expected": [1000000, 1500000, 2000000]
    },
    {
      "name": "Rs 10,000 exactly",
      "input": { "total": 1000000, "unit": 100 },
      "expected": [1050000, 1100000, 1500000]
    },
    {
      "name": "Rs 12,000",
      "input": { "total": 1200000, "unit": 100 },
      "expected": [1250000, 1300000, 1500000]
    },
    {
      "name": "Rs 99,999",
      "input": { "total": 9999900, "unit": 100 },
      "expected": [10000000, 10500000, 11000000]
    }
  ]
}
