        "parties": {}
      },
      "expected": {
        "problems": [
          { "problem": "date_locked", "row": null },
          { "problem": "narration_required", "row": null },
          { "problem": "unbalanced", "row": null }
        ],
        "debit": 5000000,
        "credit": 4000000
      }
    },
    {
      "name": "one line only",
      "input": {
        "date": "2027-01-10",
        "today": "2027-01-10",
        "lockDate": null,
        "narration": "Half a voucher",
