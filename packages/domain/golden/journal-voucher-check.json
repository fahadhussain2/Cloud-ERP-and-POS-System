{
  "description": "A journal voucher before it is posted (ACC-05, W1-19, D-108). Header problems first (the date as for every back-office document; a narration; at least two lines; debits = credits, judged only when every line's amount is valid), then per line in line order: an account; postable; active; not one the system keeps (INVENTORY, CASH_DRAWER, CASH_IN_TRANSIT); a debit or a credit, a whole number of paisa above 0, never both; on AR_CONTROL a customer and on AP_CONTROL a supplier, and no party on any other account. The totals are Σ debits and Σ credits of the valid lines.",
  "cases": [
    {
      "name": "clearing Rs 3 of posting suspense into cash rounding",
      "input": {
        "date": "2027-01-31",
        "today": "2027-02-01",
        "lockDate": "2026-12-31",
        "narration": "Clear suspense from bills that didn't add up",
        "lines": [
          { "accountId": "acc-rounding", "partyId": null, "debit": 300, "credit": 0 },
          { "accountId": "acc-suspense", "partyId": null, "debit": 0, "credit": 300 }
        ],
        "accounts": {
          "acc-rounding": { "postable": true, "active": true, "role": "ROUNDING" },
          "acc-suspense": { "postable": true, "active": true, "role": "SUSPENSE" }
        },
        "parties": {}
      },
      "expected": { "problems": [], "debit": 300, "credit": 300 }
    },
    {
      "name": "a customer's bad debt written off, with the customer on the AR line",
      "input": {
        "date": "2027-01-31",
        "today": "2027-01-31",
        "lockDate": null,
        "narration": "Write off",
        "lines": [
          { "accountId": "acc-general", "partyId": null, "debit": 150000, "credit": 0 },
          { "accountId": "acc-ar", "partyId": "cust-1", "debit": 0, "credit": 150000 }
        ],
        "accounts": {
          "acc-general": { "postable": true, "active": true, "role": null },
          "acc-ar": { "postable": true, "active": true, "role": "AR_CONTROL" }
        },
        "parties": { "cust-1": { "customer": true, "supplier": false } }
      },
      "expected": { "problems": [], "debit": 150000, "credit": 150000 }
    },
    {
      "name": "unbalanced, no narration, dated on the lock date",
      "input": {
        "date": "2026-12-31",
        "today": "2027-01-10",
        "lockDate": "2026-12-31",
        "narration": "  ",
        "lines": [
          { "accountId": "acc-drawings", "partyId": null, "debit": 5000000, "credit": 0 },
          { "accountId": "acc-hbl", "partyId": null, "debit": 0, "credit": 4000000 }
        ],
        "accounts": {
          "acc-drawings": { "postable": true, "active": true, "role": null },
          "acc-hbl": { "postable": true, "active": true, "role": null }
