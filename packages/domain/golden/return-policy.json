        "original": "2026-11-02",
        "today": "2026-11-12",
        "windowDays": 30,
        "items": [{}]
      },
      "expected": {
        "needs": [],
        "daysSince": 10,
        "outsideWindow": false,
        "nonReturnable": false,
        "approverMay": null
      }
    },
