{
  "description": "What a journal voucher line does to its account, shown under the account as you type (owner's review of W1-19, D-108). Debits raise assets and expenses and lower liabilities, equity and income; credits do the opposite. A customer line (AR_CONTROL) says the customer owes you more or less, a supplier line (AP_CONTROL) that you owe them more or less. The amount is the line's debit less credit, either way round; no hint while it is 0 or not a whole number of paisa.",
  "cases": [
    {
      "name": "Bank charges debited 2,000: an expense goes up",
      "input": {
        "account": {
          "type": "expense",
          "role": null
        },
        "debit": 200000,
        "credit": 0
      },
      "expected": {
        "kind": "account",
        "direction": "up",
        "amount": 200000
      }
    },
    {
      "name": "Utilities credited 2,000: an expense goes down",
      "input": {
        "account": {
          "type": "expense",
          "role": null
        },
        "debit": 0,
        "credit": 200000
      },
      "expected": {
        "kind": "account",
        "direction": "down",
        "amount": 200000
      }
    },
    {
      "name": "HBL debited: a bank goes up",
      "input": {
        "account": {
          "type": "asset",
          "role": "BANK"
        },
        "debit": 500000,
        "credit": 0
      },
      "expected": {
        "kind": "account",
        "direction": "up",
        "amount": 500000
      }
    },
    {
      "name": "the safe credited: it goes down",
      "input": {
        "account": {
          "type": "asset",
          "role": "CASH_SAFE"
        },
        "debit": 0,
        "credit": 120000
      },
      "expected": {
        "kind": "account",
        "direction": "down",
        "amount": 120000
      }
    },
    {
