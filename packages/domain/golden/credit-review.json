          "balanceBefore": 9000000,
          "offlineTodayBefore": 0
        }
      },
      "expected": [
        {
          "kind": "credit_limit_exceeded",
          "cause": "no_approval",
          "amount": 2000000,
          "balance": 9000000,
          "limit": 10000000,
          "overBy": 1000000
        }
      ]
    },
