{
  "description": "The server's credit re-check of a synced sale (sync spec §6.2, POS-07, D-011, D-096): findings, never a refusal. Each case changes a base document (credit-review.test.ts: a Rs 20,000 bill fully on account to customer …f1, sold by …a1 in branch …e1) and gives what the server holds: the customer's account (a Rs 100,000 limit and a Rs 25,000 cap unless a case says otherwise), its balance before this bill (every counter's sales) and this device's offline on-account total for the customer on that business date, before this bill. Staff: …a1 a salesman (pos.credit.sell); …a2 a manager (pos.credit.sell, pos.credit.over_limit); …a4 no credit rights; …a9 is unknown.",
  "cases": [
    {
      "name": "a cash sale to a customer: nothing to check",
      "input": {
        "document": {
          "payments": [
            { "method": "cash", "amount": 2000000, "cashReceived": null, "changeDue": 0, "reference": null }
          ]
        },
        "context": {
          "account": { "creditAllowed": true, "creditLimit": 0, "offlineDailyCap": 0 },
          "balanceBefore": 50000000,
          "offlineTodayBefore": 0
        }
      },
      "expected": []
    },
    {
      "name": "on account within the limit",
      "input": {
        "document": {},
        "context": {
          "account": { "creditAllowed": true, "creditLimit": 10000000, "offlineDailyCap": 2500000 },
          "balanceBefore": 4500000,
          "offlineTodayBefore": 0
        }
      },
      "expected": []
    },
    {
      "name": "exactly at the limit",
      "input": {
        "document": {},
