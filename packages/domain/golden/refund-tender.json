{
  "description": "Settling a bill with returned lines (POS spec §12, §19, POS-17, PRD W7, D-007, owner answer 1 to W1-13): the same rules as a sale when the total is above 0; one refund row when it is below 0 (cash at the desk, on account for a customer with a customer account, or a transfer to a bank or wallet method with its reference); no row at all for an even exchange. Delux's methods, Rs 1 rounding. A cash refund records no cash received or change; its cash due is negative (a payout at the desk). The first problem, for a refund: no_payment, refund_one_method, unknown_method, refund_needs_account, amount_not_rounded, reference_required, reference_too_long, sum_mismatch, cash_received_on_refund; for an even exchange: even_takes_no_payment. `settlement` is settleTender's result when there is no problem.",
  "cases": [
    {
      "name": "a refund in cash at the desk",
      "input": {
        "total": -435000,
        "payments": [
          {
            "method": "cash",
            "amount": -435000,
            "reference": null
          }
        ],
        "cashReceived": null,
        "hasCustomerAccount": false
      },
      "expected": {
        "problem": null,
        "settlement": {
          "payments": [
            {
              "method": "cash",
              "amount": -435000,
              "cashReceived": null,
              "changeDue": null,
              "reference": null
            }
          ],
          "cashDue": -435000,
          "change": 0
        }
      }
    },
    {
      "name": "a refund to the customer's account",
      "input": {
        "total": -435000,
        "payments": [
          {
            "method": "on_account",
            "amount": -435000,
            "reference": null
          }
        ],
        "cashReceived": null,
        "hasCustomerAccount": true
      },
      "expected": {
        "problem": null,
        "settlement": {
          "payments": [
            {
              "method": "on_account",
              "amount": -435000,
              "cashReceived": null,
              "changeDue": null,
              "reference": null
            }
          ],
          "cashDue": 0,
          "change": 0
        }
      }
    },
    {
      "name": "to account without a customer account",
      "input": {
        "total": -435000,
        "payments": [
          {
            "method": "on_account",
            "amount": -435000,
            "reference": null
          }
        ],
        "cashReceived": null,
        "hasCustomerAccount": false
      },
      "expected": {
        "problem": "refund_needs_account",
        "settlement": null
      }
    },
