          "cashReceived": 500000,
          "handoverStatus": "pending"
        }
      },
      "expected": {
        "ok": true,
        "kind": "in",
        "amount": 432000,
        "cashReceived": 500000,
        "changeGiven": 68000,
        "correctedFrom": null
      }
    },
