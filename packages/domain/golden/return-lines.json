    {
      "name": "more than is left is refused",
      "input": {
        "line": {
          "lineNo": 2,
          "itemId": "019a0000-0000-7000-8000-0000000000c3",
          "qty": 3000,
          "lineTotal": 1000000
        },
        "returned": {
          "qty": 1000,
          "refund": 333333
        },
        "qty": 2500
