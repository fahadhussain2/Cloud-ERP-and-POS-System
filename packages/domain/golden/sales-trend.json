        "step": "day",
        "days": [
          {
            "date": "2027-01-05",
            "bills": 1,
            "sales": -117526,
            "profit": -37526
          }
        ]
      },
      "expected": [
        {
          "from": "2027-01-04",
          "to": "2027-01-04",
          "bills": 0,
          "sales": 0,
          "profit": 0
        },
        {
          "from": "2027-01-05",
          "to": "2027-01-05",
          "bills": 1,
          "sales": -117526,
          "profit": -37526
