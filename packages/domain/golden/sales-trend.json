            "date": "2027-01-02",
            "bills": 3,
            "sales": 100000,
            "profit": 30000
          },
          {
            "date": "2027-01-05",
            "bills": 2,
            "sales": 50000,
            "profit": 10000
          },
          {
            "date": "2027-01-10",
            "bills": 1,
            "sales": 20000,
            "profit": 5000
          }
        ]
      },
      "expected": [
        {
          "from": "2027-01-01",
          "to": "2027-01-03",
          "bills": 3,
          "sales": 100000,
          "profit": 30000
