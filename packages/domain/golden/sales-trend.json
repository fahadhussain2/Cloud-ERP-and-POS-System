        {
          "from": "2027-01-04",
          "to": "2027-01-10",
          "bills": 3,
          "sales": 70000,
          "profit": 15000
        },
        {
          "from": "2027-01-11",
          "to": "2027-01-17",
          "bills": 0,
          "sales": 0,
          "profit": 0
        },
        {
          "from": "2027-01-18",
          "to": "2027-01-20",
          "bills": 0,
          "sales": 0,
          "profit": 0
        }
      ]
