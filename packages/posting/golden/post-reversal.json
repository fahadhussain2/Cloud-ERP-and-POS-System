        "posting": {
          "entryDate": "2027-02-01",
          "journal": {
            "branchId": "br-main",
            "memo": "JV000010 FT000002",
            "lines": [
              { "accountId": "1160", "partyId": null, "debit": 0, "credit": 975000 },
              { "accountId": "6310", "partyId": null, "debit": 0, "credit": 25000 },
              { "accountId": "1180", "partyId": null, "debit": 1000000, "credit": 0 }
