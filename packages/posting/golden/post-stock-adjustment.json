{
  "description": "Posting a stock adjustment (posting rules §5.3, INV-05, W1-18): per line, into (found, qty > 0) or out of (gone, qty < 0) its location at the item's current average, the average unchanged and the quantity on hand moved. The net value posts as one pair: a gain Dr INVENTORY / Cr INVENTORY_ADJUSTMENT, a loss Dr INVENTORY_ADJUSTMENT / Cr INVENTORY; a net of 0 has no journal. An item with no cost known moves at 0, flagged no_cost once; stock below 0 is flagged negative_stock, never refused. A write-off is a loss out of Damaged.",
  "cases": [
    {
      "name": "3 lost from the Shop at the Rs 4,000 average",
      "input": {
        "adjustment": {
          "id": "ad-1",
          "number": "AD000001",
          "branchId": "br-main",
          "businessDate": "2026-11-08",
          "lines": [{ "id": "adl-1", "itemId": "item-a", "locationId": "loc-shop", "qty": -3000 }]
        },
        "state": {
          "costs": { "item-a": { "avgCost": 400000, "onHand": 10000 } },
          "balances": { "loc-shop": { "item-a": 6000 } }
        }
      },
      "expected": {
        "ok": true,
        "posting": {
          "entryDate": "2026-11-08",
          "journal": {
            "branchId": "br-main",
            "memo": "AD000001",
            "lines": [
              { "accountId": "5200", "partyId": null, "debit": 1200000, "credit": 0 },
              { "accountId": "1300", "partyId": null, "debit": 0, "credit": 1200000 }
            ]
          },
          "movements": [
            {
              "sourceLineId": "adl-1",
              "itemId": "item-a",
              "locationId": "loc-shop",
              "qtyDelta": -3000,
              "unitCost": 400000,
              "valueDelta": -1200000,
              "avgCostAfter": 400000
            }
          ],
          "partyEntries": [],
          "exceptions": [],
          "state": {
            "costs": { "item-a": { "avgCost": 400000, "onHand": 7000 } },
            "balances": { "loc-shop": { "item-a": 3000 } }
          }
        }
      }
    },
