          "exceptions": [],
          "state": {
            "costs": { "item-a": { "avgCost": 122500, "onHand": 20000 } },
            "balances": { "loc-godown": { "item-a": 10000 } }
          },
          "lastPurchases": [
            {
              "itemId": "item-a",
              "lastCost": 125000,
