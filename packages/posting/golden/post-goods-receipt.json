{
  "description": "Posting a goods receipt (posting rules §5.1, PUR-02, W1-16): one stock movement per line into its location at the line's exact net value (the bill discount already capitalized), unit cost = value ÷ qty half away from zero; each item's average re-computed from the value, (on hand × average + value) ÷ (on hand + qty), or value ÷ qty when nothing (or less) was on hand or no cost was known; the last purchase per item. Journal: Dr INVENTORY Σ values, Cr AP_CONTROL (the supplier) the total, due on the due date. Paid by bank (owner answer 1): then also Dr AP_CONTROL (the supplier) / Cr the bank's account, and the supplier owes back the same on the entry date. Σ values must equal the total; a bank without an account is target_unmapped.",
  "cases": [
    {
      "name": "on credit: two items into Shop, nothing on hand before",
      "input": {
        "receipt": {
          "id": "gr-1",
          "number": "GR000001",
          "branchId": "br-main",
          "businessDate": "2026-11-05",
          "supplierId": "sup-naveed",
          "dueDate": "2026-12-05",
          "total": 1340100,
          "receivedAt": "2026-11-05T09:30:00.000Z",
          "paidFrom": null,
          "lines": [
            { "id": "grl-1", "itemId": "item-a", "locationId": "loc-shop", "qty": 10000, "value": 1250000 },
            { "id": "grl-2", "itemId": "item-b", "locationId": "loc-shop", "qty": 2000, "value": 90100 }
          ]
        }
      },
      "expected": {
        "ok": true,
        "posting": {
          "entryDate": "2026-11-05",
          "journal": {
            "branchId": "br-main",
            "memo": "GR000001",
            "lines": [
              { "accountId": "1300", "partyId": null, "debit": 1340100, "credit": 0 },
              { "accountId": "2100", "partyId": "sup-naveed", "debit": 0, "credit": 1340100 }
            ]
          },
          "movements": [
            {
              "sourceLineId": "grl-1",
              "itemId": "item-a",
              "locationId": "loc-shop",
              "qtyDelta": 10000,
              "unitCost": 125000,
              "valueDelta": 1250000,
              "avgCostAfter": 125000
            },
            {
              "sourceLineId": "grl-2",
              "itemId": "item-b",
              "locationId": "loc-shop",
              "qtyDelta": 2000,
              "unitCost": 45050,
              "valueDelta": 90100,
              "avgCostAfter": 45050
            }
          ],
          "partyEntries": [
            { "partyId": "sup-naveed", "role": "supplier", "amount": 1340100, "dueDate": "2026-12-05" }
          ],
          "exceptions": [],
          "state": {
            "costs": {
              "item-a": { "avgCost": 125000, "onHand": 10000 },
              "item-b": { "avgCost": 45050, "onHand": 2000 }
            },
            "balances": { "loc-shop": { "item-a": 10000, "item-b": 2000 } }
          },
          "lastPurchases": [
            {
              "itemId": "item-a",
              "lastCost": 125000,
              "lastSupplierId": "sup-naveed",
              "lastReceiptAt": "2026-11-05T09:30:00.000Z"
            },
            {
              "itemId": "item-b",
              "lastCost": 45050,
              "lastSupplierId": "sup-naveed",
              "lastReceiptAt": "2026-11-05T09:30:00.000Z"
            }
          ]
        }
      }
    },
    {
