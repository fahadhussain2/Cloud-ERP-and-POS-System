          "businessDate": "2027-01-10",
          "from": null,
          "to": "bank-soneri",
          "amount": 50000000,
          "charges": 0,
          "chargesCategoryId": null
        }
      },
      "expected": {
        "ok": true,
        "posting": {
          "entryDate": "2027-01-10",
          "journal": {
            "branchId": "br-main",
            "memo": "FT000001",
            "lines": [
              { "accountId": "1150", "partyId": null, "debit": 50000000, "credit": 0 },
              { "accountId": "1130", "partyId": null, "debit": 0, "credit": 50000000 }
            ]
          },
          "movements": [],
          "partyEntries": [],
          "exceptions": [],
          "state": { "costs": {}, "balances": {} }
        }
      }
    },
