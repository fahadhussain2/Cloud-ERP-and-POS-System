        "transfer": {
          "id": "ft-3",
          "number": "FT000003",
          "branchId": "br-main",
          "businessDate": "2026-12-31",
          "from": "bank-hbl",
          "to": null,
          "amount": 2000000,
          "charges": 0,
          "chargesCategoryId": null
