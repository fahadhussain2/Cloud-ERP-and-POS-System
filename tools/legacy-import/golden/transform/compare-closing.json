    {
      "name": "the report agrees with the computation: no rows",
      "input": {
        "asOf": "2026-11-05",
        "docTypes": { "21": 1, "31": -1 },
        "openings": [{ "itemId": "ABEA001", "qty": "2.00" }],
        "lines": [{ "itemId": "ABEA001", "docType": "31", "date": "2026-08-01 10:00:00.000", "qty": "1.00" }],
        "records": [
