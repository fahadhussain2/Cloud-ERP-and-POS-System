        ],
        "running": [{ "itemId": "ABEA001", "qty": 1000 }],
        "legacy": [{ "itemId": "ABEA001", "qty": "1.00" }]
      },
      "expected": {
        "counts": {
          "legacyItems": 1,
          "same": 1,
          "differ": 0,
          "matchRecords": 0,
          "matchRunning": 0,
          "none": 0,
          "notInReport": 0,
          "notOurs": 0
