{
  "description": "An item's opening cost (migration doc §4.1): the latest valuation rate on or before the cutoff, else INV_Item.CostPrice, else INV_Item.OpeningRate, else none (flagged, valued at 0 until fixed). A rate of 0 or less, or empty, counts as none. Minor units, half away from zero.",
  "cases": [
    {
      "name": "the valuation rate",
      "input": { "valuationRate": 310000, "costPrice": "3000.00", "openingRate": "2900.00" },
      "expected": { "unitCost": 310000, "source": "valuation_rate" }
    },
    {
      "name": "no valuation rate: the cost price",
      "input": { "valuationRate": null, "costPrice": "3000.00", "openingRate": "2900.00" },
      "expected": { "unitCost": 300000, "source": "cost_price" }
    },
    {
      "name": "a valuation rate of 0: the cost price",
      "input": { "valuationRate": 0, "costPrice": "3000.00", "openingRate": null },
      "expected": { "unitCost": 300000, "source": "cost_price" }
    },
    {
      "name": "cost price 0: the opening rate",
      "input": { "valuationRate": null, "costPrice": "0.00", "openingRate": "2900.00" },
      "expected": { "unitCost": 290000, "source": "opening_rate" }
    },
    {
      "name": "a negative cost price is no cost: the opening rate",
      "input": { "valuationRate": null, "costPrice": "-5.00", "openingRate": "12.505" },
      "expected": { "unitCost": 1251, "source": "opening_rate" }
    },
    {
      "name": "nothing: no cost",
      "input": { "valuationRate": null, "costPrice": null, "openingRate": "0" },
      "expected": { "unitCost": null, "source": null }
    },
    {
      "name": "a cost price that isn't a number stops the run",
      "input": { "valuationRate": null, "costPrice": "abc", "openingRate": null },
      "error": "bad_amount"
    }
  ]
}
