{
  "description": "Legacy DateTime values (migration doc §1, importer spec §3): CAST(0x<8 bytes> AS DateTime) is 4-byte signed days since 1900-01-01, then 4-byte ticks of 1/300 s, shown to the millisecond the way SQL Server rounds them. Encodings computed independently with Python's date arithmetic.",
  "cases": [
    {
      "name": "zero is 1900-01-01 midnight",
      "input": "0000000000000000",
      "expected": "1900-01-01 00:00:00.000"
    },
    { "name": "one tick is .003", "input": "0000000000000001", "expected": "1900-01-01 00:00:00.003" },
    { "name": "two ticks are .007", "input": "0000000000000002", "expected": "1900-01-01 00:00:00.007" },
    { "name": "three ticks are .010", "input": "0000000000000003", "expected": "1900-01-01 00:00:00.010" },
    { "name": "299 ticks are .997", "input": "000000000000012B", "expected": "1900-01-01 00:00:00.997" },
    {
      "name": "300 ticks are one second",
      "input": "000000000000012C",
      "expected": "1900-01-01 00:00:01.000"
    },
    { "name": "a sale on 6 Dec 2025", "input": "0000B3AB00E7958C", "expected": "2025-12-06 14:03:10.333" },
    {
      "name": "the start of the Jul 2025 period",
      "input": "0000B30D00000000",
      "expected": "2025-07-01 00:00:00.000"
    },
    { "name": "the last second of 2026", "input": "0000B531018B80D4", "expected": "2026-12-31 23:59:59.000" },
    {
      "name": "negative days: the day before 1900",
      "input": "FFFFFFFF018B81FF",
      "expected": "1899-12-31 23:59:59.997"
    },
    {
      "name": "the earliest DateTime, 1753-01-01",
      "input": "FFFF2E4600000000",
      "expected": "1753-01-01 00:00:00.000"
    },
    { "name": "lower-case hex", "input": "0000b3ab00e7958c", "expected": "2025-12-06 14:03:10.333" },
    { "name": "not 8 bytes", "input": "0000B3AB00E795", "error": "bad_datetime" },
    { "name": "ticks past the end of the day", "input": "00000000018B8200", "error": "bad_datetime" }
  ]
}
