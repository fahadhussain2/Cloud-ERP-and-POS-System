# Edge proxy: TLS, security headers, static apps and /api (W0-03, architecture §9.0).
# Until W0-04 deploys the apps, each site serves a placeholder and /api answers 503.
{
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

(common) {
	encode zstd gzip
	header {
		# No includeSubDomains: the marketing site on the apex is managed elsewhere.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}
	# The API is served on each app's own origin (D-065).
	handle /api/* {
		reverse_proxy {args[0]}:3000
	}
	handle {
		root * /srv/placeholder
		file_server
	}
	# The API container is not deployed yet: answer 503 instead of 502.
	handle_errors 502 {
		respond "Service unavailable" 503
	}
}

(staging) {
	header X-Robots-Tag "noindex, nofollow"
}

pos.zorbixtechnologies.com {
	import common erp-prod-api
}

app.zorbixtechnologies.com {
	import common erp-prod-api
}

staging-pos.zorbixtechnologies.com {
	import common erp-staging-api
	import staging
}

staging-app.zorbixtechnologies.com {
	import common erp-staging-api
	import staging
}
