# Edge proxy: TLS, security headers, and routing to each environment's containers (W0-03, W0-04).
#   /api/*        → erp-<env>-api:3000
#   everything else → erp-<env>-web:8080 (POS) or :8081 (back office)
# An environment that isn't deployed answers 503.
{
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

# app <env> <web port>
(app) {
	encode zstd gzip
	header {
		# No includeSubDomains: the marketing site on the apex is managed elsewhere.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}
	# The API is served on each app's own origin (D-065).
	handle /api/* {
		reverse_proxy erp-{args[0]}-api:3000
	}
	handle {
		reverse_proxy erp-{args[0]}-web:{args[1]}
	}
	handle_errors 502 {
		respond "Service unavailable" 503
	}
}

(staging) {
	header X-Robots-Tag "noindex, nofollow"
}

pos.zorbixtechnologies.com {
	import app prod 8080
}

app.zorbixtechnologies.com {
	import app prod 8081
}

staging-pos.zorbixtechnologies.com {
	import app staging 8080
	import staging
}

staging-app.zorbixtechnologies.com {
	import app staging 8081
	import staging
}
