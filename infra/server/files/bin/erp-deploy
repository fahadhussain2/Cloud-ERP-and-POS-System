#!/usr/bin/env bash
# The only program the GitHub deploy key may run (forced command, D-075). Installed by bootstrap.sh.
#
#   has <tag>                 exit 0 if all three images for <tag> are on the server
#   load                      docker load from stdin; only erp-{api,worker,web}:<tag> are accepted
#   status <env>              current=<tag> previous=<tag>
#   deploy <env> <tag>        stdin: tar.gz of infra/app. Migrate, start, check; roll back on failure.
#   rollback <env>            switch back to the previous release
#   backup-status prod        print the database backup status (read-only, for the nightly check; W0-05)
#
# <env> is prod or staging; <tag> is a 40-character git tree hash.
set -euo pipefail

ROOT=/srv/erp
KEEP=5
IMAGES=(api worker web)

die() {
  echo "erp-deploy: $*" >&2
  exit 1
}
say() { echo "erp-deploy: $*"; }

read -r -a argv <<<"${SSH_ORIGINAL_COMMAND:-${*:-}}"
cmd=${argv[0]:-}

check_env() { [[ ${1:-} == prod || ${1:-} == staging ]] || die "environment must be prod or staging"; }
check_tag() { [[ ${1:-} =~ ^[0-9a-f]{40}$ ]] || die "tag must be a 40-character tree hash"; }

has_images() {
  local image
  for image in "${IMAGES[@]}"; do
    docker image inspect "erp-$image:$1" >/dev/null 2>&1 || return 1
  done
}

state() { cat "$ROOT/$1/$2" 2>/dev/null || true; }

record() { # env action tag result
  printf '%s %s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$2" "$3" "$4" >>"$ROOT/$1/releases.log"
}

compose() { # env tag args...
  local env=$1 tag=$2 dir="$ROOT/$1/releases/$2"
  shift 2
  IMAGE_TAG=$tag docker compose -p "erp-$env" --project-directory "$dir" \
    -f "$dir/compose.yaml" --env-file "$dir/$env.env" "$@"
}

# The running release must answer with its own version, serve both apps and keep the worker up.
verify() { # env tag
  local env=$1 tag=$2 health worker
  health=$(compose "$env" "$tag" exec -T api wget -qO- http://127.0.0.1:3000/api/health) || return 1
  [[ $health == *"\"version\":\"$tag\""* ]] || {
    echo "health check returned: $health" >&2
    return 1
  }
  compose "$env" "$tag" exec -T web wget -qO /dev/null http://127.0.0.1:8080/ || return 1
  compose "$env" "$tag" exec -T web wget -qO /dev/null http://127.0.0.1:8081/ || return 1
  sleep 5
  worker=$(docker inspect -f '{{.State.Running}} {{.RestartCount}}' "$(compose "$env" "$tag" ps -q worker)") || return 1
  [[ $worker == "true 0" ]] || {
    echo "worker not stable: $worker" >&2
    return 1
  }
}

start() { # env tag
  compose "$1" "$2" up -d --remove-orphans --wait --wait-timeout 90 && verify "$1" "$2"
}

# Keep the newest $KEEP release folders per environment, and only the images they or the
# other environment still use.
prune() {
  local env keep=() tag image ref
  for env in prod staging; do
    [[ -d $ROOT/$env/releases ]] || continue
    while read -r tag; do
      [[ $tag == "$(state "$env" current)" || $tag == "$(state "$env" previous)" ]] && continue
      rm -rf "${ROOT:?}/$env/releases/$tag"
    done < <(find "$ROOT/$env/releases" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %f\n' |
      sort -rn | awk -v keep="$KEEP" 'NR > keep {print $2}')
    while read -r tag; do keep+=("$tag"); done < <(find "$ROOT/$env/releases" -mindepth 1 -maxdepth 1 -type d -printf '%f\n')
  done
  while read -r ref; do
    tag=${ref##*:}
    [[ " ${keep[*]} " == *" $tag "* ]] && continue
    docker image rm "$ref" >/dev/null 2>&1 || true
  done < <(for image in "${IMAGES[@]}"; do docker image ls "erp-$image" --format '{{.Repository}}:{{.Tag}}'; done)
}

case $cmd in
  has)
    check_tag "${argv[1]:-}"
    has_images "${argv[1]}"
    ;;

  load)
    # Check the archive's image names *before* loading, so it can't overwrite any other image.
    tmp=$(mktemp -d /var/tmp/erp-load.XXXXXX)
    trap 'rm -rf "$tmp"' EXIT
    cat >"$tmp/images.tar.gz"
    tags=$(tar -xOf "$tmp/images.tar.gz" manifest.json |
      python3 -c 'import json, sys; print("\n".join(t for m in json.load(sys.stdin) for t in (m.get("RepoTags") or [])))') ||
      die "not a docker save archive"
    [[ -n $tags ]] || die "archive has no image names"
    while read -r ref; do
      [[ $ref =~ ^erp-(api|worker|web):[0-9a-f]{40}$ ]] || die "refused image $ref"
    done <<<"$tags"
    docker load -i "$tmp/images.tar.gz"
    ;;

  status)
    check_env "${argv[1]:-}"
    echo "current=$(state "${argv[1]}" current) previous=$(state "${argv[1]}" previous)"
    ;;

  deploy)
    env=${argv[1]:-}
    tag=${argv[2]:-}
    check_env "$env"
    check_tag "$tag"
    has_images "$tag" || die "images for $tag are not on the server; load them first"
    mkdir -p "$ROOT/$env/releases"
    exec 9>"$ROOT/$env/.lock"
    flock -n 9 || die "another deploy to $env is running"

    current=$(state "$env" current)
    dir="$ROOT/$env/releases/$tag"
    rm -rf "$dir"
    mkdir -p "$dir"
    tar -C "$dir" -xzf -
    [[ -f $dir/compose.yaml && -f $dir/$env.env ]] || die "bundle must contain compose.yaml and $env.env"

    say "migrating ($env, $tag)"
    if ! compose "$env" "$tag" run --rm --no-deps api node dist/migrate.js; then
      record "$env" deploy "$tag" migration-failed
      die "migration failed; ${current:-nothing} keeps running"
    fi

    say "starting $tag"
    if start "$env" "$tag"; then
      if [[ -n $current && $current != "$tag" ]]; then echo "$current" >"$ROOT/$env/previous"; fi
      echo "$tag" >"$ROOT/$env/current"
      record "$env" deploy "$tag" ok
      prune
      say "deployed $tag to $env"
      exit 0
    fi

    if [[ -n $current && $current != "$tag" ]] && start "$env" "$current"; then
      record "$env" deploy "$tag" rolled-back-to-"$current"
      die "new release unhealthy; rolled back to $current"
    fi
    compose "$env" "$tag" down || true
    record "$env" deploy "$tag" failed
    die "new release unhealthy and no healthy previous release; $env is down"
    ;;

  rollback)
    env=${argv[1]:-}
    check_env "$env"
    exec 9>"$ROOT/$env/.lock"
    flock -n 9 || die "another deploy to $env is running"
    current=$(state "$env" current)
    previous=$(state "$env" previous)
    [[ -n $previous && -d $ROOT/$env/releases/$previous ]] || die "no previous release to roll back to"
    start "$env" "$previous" || die "previous release $previous is unhealthy too"
    echo "$previous" >"$ROOT/$env/current"
    echo "$current" >"$ROOT/$env/previous"
    record "$env" rollback "$previous" ok
    say "rolled back $env to $previous"
    ;;

  backup-status)
    [[ ${argv[1]:-} == prod ]] || die "backups run only for prod"
    cat "$ROOT/prod/backup-status.json" || die "no backup status yet"
    ;;

  *)
    die "allowed commands: has, load, status, deploy, rollback, backup-status"
    ;;
esac
