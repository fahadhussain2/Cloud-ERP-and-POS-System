{
  "name": "cloud-erp-pos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r --parallel typecheck",
    "test": "vitest run --coverage --exclude \"**/*.int.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e": "pnpm --filter @erp/e2e e2e",
    "db:up": "docker compose -f infra/dev/compose.yaml up -d --wait",
    "db:down": "docker compose -f infra/dev/compose.yaml down",
    "dev:db": "pnpm --filter @erp/db exec tsx src/testing/dev.ts",
    "dev:reset-password": "pnpm --filter @erp/api exec tsx src/dev-reset-password.ts",
    "legacy:stage": "pnpm --filter @erp/legacy-import start stage",
    "legacy:import": "pnpm --filter @erp/legacy-import start load",
    "test:watch": "vitest --exclude \"**/*.int.test.ts\"",
    "build": "pnpm -r build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
